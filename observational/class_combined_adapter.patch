+double V_scf(struct background *pba, double phi) {
+  /* C1Q_PATCH_V1: x=phi/Mpl; potential units Mpc^-2; parameter[0]=m/H0. */
+  return 0.5 * pow(pba->scf_parameters[0]*pba->H0,2) * phi*phi;
 }
 
-double dV_scf(
-              struct background *pba,
-              double phi) {
-  return dV_e_scf(pba,phi)*V_p_scf(pba,phi) + V_e_scf(pba,phi)*dV_p_scf(pba,phi);
+double dV_scf(struct background *pba, double phi) {
+  /* C1Q_PATCH_V1: x=phi/Mpl; potential units Mpc^-2; parameter[0]=m/H0. */
+  return pow(pba->scf_parameters[0]*pba->H0,2) * phi;
 }
 
-double ddV_scf(
-               struct background *pba,
-               double phi) {
-  return ddV_e_scf(pba,phi)*V_p_scf(pba,phi) + 2*dV_e_scf(pba,phi)*dV_p_scf(pba,phi) + V_e_scf(pba,phi)*ddV_p_scf(pba,phi);
+double ddV_scf(struct background *pba, double phi) {
+  /* C1Q_PATCH_V1: x=phi/Mpl; potential units Mpc^-2; parameter[0]=m/H0. */
+  return pow(pba->scf_parameters[0]*pba->H0,2);
 }
